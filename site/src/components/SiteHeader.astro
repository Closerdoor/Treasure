---
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', label: '首页' },
  { href: '/video', label: '影视' },
  { href: '/about', label: '关于' },
  { href: '/search', label: '搜索' }
];
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="site-header__brand" href="/">
      <span class="site-header__mark">Treasure</span>
      <span class="site-header__name">资料馆</span>
    </a>

    <nav class="site-header__nav" aria-label="主导航">
      {navItems.map((item) => (
        <a class:list={["site-header__link", currentPath === item.href && 'is-active']} href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__tools">
      <a class="site-header__search" href="/search">搜索</a>
      <ThemeToggle />
    </div>
  </div>
</header>
