---
import type { ArchiveMovie } from '../lib/archive';
import { formatExternalSourceLabel } from '../lib/site';

const { movie } = Astro.props as { movie: ArchiveMovie };

const leadCast = movie.cast ?? [];
const otherCastList = movie.otherCast ?? [];
const producerList = movie.producer ?? [];
type CreditPerson = NonNullable<ArchiveMovie['director']>[number];
type CreditRailItem = CreditPerson & { jobLabel: string; isActor: boolean };

function buildCreditsCarousel() {
  const creditsMap = new Map<string, { person: CreditPerson; labels: string[]; isActor: boolean }>();

  const append = (people: CreditPerson[], resolveLabel: (person: CreditPerson) => string, isActor: boolean) => {
    for (const person of people) {
      const key = person.personCode || person.nameEn || person.name;
      const label = resolveLabel(person);
      const existing = creditsMap.get(key);

      if (existing) {
        if (!existing.labels.includes(label)) {
          existing.labels.push(label);
        }

        if (!existing.person.avatar && person.avatar) {
          existing.person.avatar = person.avatar;
        }

        if (!existing.person.avatarPath && person.avatarPath) {
          existing.person.avatarPath = person.avatarPath;
        }

        if (!existing.person.nameEn && person.nameEn) {
          existing.person.nameEn = person.nameEn;
        }

        if (!existing.person.role && person.role) {
          existing.person.role = person.role;
        }

        continue;
      }

      creditsMap.set(key, {
        person: { ...person },
        labels: [label],
        isActor
      });
    }
  };

  append(movie.director ?? [], () => '导演', false);
  append(movie.writer ?? [], (person) => person.role || '编剧', false);
  append(leadCast, () => '演员', true);
  append(otherCastList, () => '演员', true);
  append(producerList, (person) => person.role || '制片人', false);

  return Array.from(creditsMap.values()).map(({ person, labels, isActor }) => ({
    ...person,
    jobLabel: labels.join(' / '),
    isActor
  })) satisfies CreditRailItem[];
}

const creditsCarousel = buildCreditsCarousel();
const primaryImageItems = [movie.posterUrl, ...movie.posterGallery];
const secondaryImageItems = movie.wallpaperGallery.length
  ? movie.wallpaperGallery
  : movie.stillGallery.length
    ? movie.stillGallery
    : movie.posterGallery;
const soundtrackAlbums = movie.soundtrack?.albums ?? [];
const storyParagraphs = String(movie.story?.text ?? movie.synopsis?.text ?? '')
  .split(/\n{2,}/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);

function resolvePersonAvatar(person: CreditRailItem) {
  if (person.avatarPath) {
    return `/assets/${person.avatarPath}`;
  }

  if (person.avatar) {
    return `/assets/${movie.module}/${movie.submodule}/${movie.id}/${person.avatar}`;
  }

  return '/assets/avatar-placeholder.svg';
}

function getReviewParagraphs(content: string | null | undefined) {
  return String(content ?? '')
    .split(/\n{2,}/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);
}

const tabItems = [
  { id: 'story', label: '详情介绍' },
  { id: 'credits', label: '演职员' },
  { id: 'images', label: '图片', hidden: !movie.stillGallery.length && !movie.posterGallery.length },
  { id: 'reviews', label: '精彩影评' },
  { id: 'music', label: '音乐', hidden: !soundtrackAlbums.length },
  { id: 'videos', label: '视频', hidden: !movie.videos?.length },
  { id: 'links', label: '外部来源' }
].filter((item) => !item.hidden);
---

<div class="detail-tabs">
  <nav class="detail-tabs__nav" aria-label="标题索引导航栏" data-detail-index>
    <span class="detail-tabs__nav-label">标题索引</span>
    {tabItems.map((item, index) => (
      <a
        class:list={["detail-tabs__tab", index === 0 && 'is-active']}
        href={`#${item.id}`}
        data-detail-tab={item.id}
        aria-current={index === 0 ? 'true' : 'false'}
      >
        {item.label}
      </a>
    ))}
    <button class="detail-tabs__top-button" type="button" data-detail-top>
      回到顶部
    </button>
  </nav>

  <section class="detail-panel" id="story">
    <div class="detail-panel__header">
      <h2>详情介绍</h2>
      <span class="detail-panel__eyebrow">Story File</span>
    </div>

    {movie.synopsis?.note ? <p class="detail-panel__lead">{movie.synopsis.note}</p> : null}

    <div class="detail-story-flow">
      {storyParagraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </section>

  <section class="detail-panel" id="credits">
    <div class="detail-panel__header">
      <h2>演职员</h2>
      <span class="detail-panel__eyebrow">Credits</span>
    </div>

    <div class="media-rail-shell" data-rail-shell>
      <div class="rail-fade rail-fade--left" aria-hidden="true"></div>
      <div class="media-rail media-rail--credits" data-rail-track>
        {creditsCarousel.map((person) => (
          <article class="credit-rail-card">
            <img
              src={resolvePersonAvatar(person)}
              alt={person.name}
              loading="lazy"
            />
            <div class="credit-rail-card__body">
              <strong>{person.name}</strong>
              {person.isActor ? (person.role ? <span>饰演 {person.role}</span> : null) : <span>{person.jobLabel}</span>}
            </div>
          </article>
        ))}
      </div>
      <button class="rail-advance rail-advance--prev" type="button" aria-label="查看更前面的演职员" data-rail-prev>
        <span aria-hidden="true">‹</span>
      </button>
      <button class="rail-advance rail-advance--next" type="button" aria-label="查看更多演职员" data-rail-next>
        <span aria-hidden="true">›</span>
      </button>
      <div class="rail-fade rail-fade--right" aria-hidden="true"></div>
    </div>
  </section>

  {movie.posterGallery.length || movie.stillGallery.length ? (
    <section class="detail-panel" id="images">
      <div class="detail-panel__header">
        <h2>图片</h2>
        <span class="detail-panel__eyebrow">Visual Archive</span>
      </div>

      <div class="image-rail-shell" data-rail-shell data-rail-sync>
        <div class="rail-fade rail-fade--left" aria-hidden="true"></div>
        <div class="image-rail-stack">
          <div class="image-rail image-rail--primary" data-rail-track>
            {primaryImageItems.map((image, index) => (
              <figure class="image-rail__item image-rail__item--primary">
                <img src={image} alt={`${movie.title} 海报或剧照 ${index + 1}`} loading="lazy" />
              </figure>
            ))}
          </div>

          <div class="image-rail image-rail--secondary" data-rail-track>
            {(secondaryImageItems.length ? secondaryImageItems : primaryImageItems.slice(0, 8)).map((image, index) => (
              <figure class="image-rail__item image-rail__item--secondary">
                <img src={image} alt={`${movie.title} 其它图片 ${index + 1}`} loading="lazy" />
              </figure>
            ))}
          </div>
        </div>

        <button class="rail-advance rail-advance--prev rail-advance--stacked" type="button" aria-label="查看更前面的图片" data-rail-prev>
          <span aria-hidden="true">‹</span>
        </button>
        <button class="rail-advance rail-advance--next rail-advance--stacked" type="button" aria-label="查看更多图片" data-rail-next>
          <span aria-hidden="true">›</span>
        </button>
        <div class="rail-fade rail-fade--right" aria-hidden="true"></div>
      </div>
    </section>
  ) : null}

  <section class="detail-panel" id="reviews">
    <div class="detail-panel__header">
      <h2>精彩影评</h2>
      <span class="detail-panel__eyebrow">Selected Notes</span>
    </div>

    <div class="review-stack">
      {(movie.reviews ?? []).map((review, index) => (
        <article class="review-card" data-review-card>
          <header class="review-card__header">
            <div class="review-card__author-row">
              <span class="review-card__mark">影评</span>
              <strong class="review-card__author">{review.author}</strong>
              <span class="review-card__source">{review.source}</span>
            </div>
            <span class="review-card__date">{review.date}</span>
          </header>
          {review.title ? <h3>{review.title}</h3> : null}
          <div class="review-card__content" data-review-content>
            {getReviewParagraphs(review.content).map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <button class="review-card__expand" type="button" data-review-expand>
            <span data-expand-text>展开全文</span>
            <span class="review-card__expand-icon" aria-hidden="true">▼</span>
          </button>
        </article>
      ))}
    </div>
  </section>

  {soundtrackAlbums.length ? (
    <section class="detail-panel" id="music">
      <div class="detail-panel__header">
        <h2>音乐</h2>
        <span class="detail-panel__eyebrow">Sound Archive</span>
      </div>

      <div class="soundtrack-stack">
        {soundtrackAlbums.map((album) => (
          <div class="soundtrack-card">
            <header>
              <div>
                <strong>{album.name || '未命名专辑'}</strong>
                <span>{album.note || album.type || '原声资料'}</span>
              </div>
              <em>{album.releaseDate || album.type || '原声资料'}</em>
            </header>
            <ol>
              {(album.tracks ?? []).map((track, index) => (
                <li>
                  <span>{`${index + 1}. `}{track.name}</span>
                  <span>{track.artist || track.duration || ''}</span>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </section>
  ) : null}

  {movie.videos?.length ? (
    <section class="detail-panel" id="videos">
      <div class="detail-panel__header">
        <h2>视频</h2>
        <span class="detail-panel__eyebrow">Video Materials</span>
      </div>

      <div class="media-rail-shell" data-rail-shell>
        <div class="rail-fade rail-fade--left" aria-hidden="true"></div>
        <div class="media-rail media-rail--videos" data-rail-track>
          {movie.videos.map((video) => (
            <a class="video-rail-card" href={video.url} target="_blank" rel="noreferrer">
              <div class="video-rail-card__thumb">
                {video.thumbnail ? (
                  <img src={`/assets/${movie.module}/${movie.submodule}/${movie.id}/${video.thumbnail}`} alt={video.title} loading="lazy" />
                ) : (
                  <span>Video</span>
                )}
              </div>
              <div class="video-rail-card__body">
                <strong>{video.title}</strong>
                <p>{video.duration || '外部视频'}</p>
              </div>
            </a>
          ))}
        </div>
        <button class="rail-advance rail-advance--prev" type="button" aria-label="查看更前面的视频物料" data-rail-prev>
          <span aria-hidden="true">‹</span>
        </button>
        <button class="rail-advance rail-advance--next" type="button" aria-label="查看更多视频物料" data-rail-next>
          <span aria-hidden="true">›</span>
        </button>
        <div class="rail-fade rail-fade--right" aria-hidden="true"></div>
      </div>
    </section>
  ) : null}

  <section class="detail-panel" id="links">
    <div class="detail-panel__header">
      <h2>外部来源</h2>
      <span class="detail-panel__eyebrow">External Index</span>
    </div>

    <div class="link-list">
      {Object.entries(movie.links ?? {}).map(([name, href]) =>
        href ? (
          <a href={href} target="_blank" rel="noreferrer">{formatExternalSourceLabel(name)}</a>
        ) : null
      )}
    </div>
  </section>

  <script is:inline>
    (() => {
      const nav = document.querySelector('[data-detail-index]');
      if (!(nav instanceof HTMLElement)) {
        return;
      }

      const tabs = [...nav.querySelectorAll('[data-detail-tab]')].filter((tab) => tab instanceof HTMLAnchorElement);
      const sections = tabs
        .map((tab) => {
          const id = tab.getAttribute('data-detail-tab');
          const section = id ? document.getElementById(id) : null;
          return section instanceof HTMLElement ? { id, tab, section } : null;
        })
        .filter(Boolean);

      if (!sections.length) {
        return;
      }

      const setActive = (id) => {
        sections.forEach((item) => {
          const isActive = item.id === id;
          item.tab.classList.toggle('is-active', isActive);
          item.tab.setAttribute('aria-current', String(isActive));
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((left, right) => right.intersectionRatio - left.intersectionRatio)[0];

          if (!(visible?.target instanceof HTMLElement)) {
            return;
          }

          setActive(visible.target.id);
        },
        {
          rootMargin: '-24% 0px -58% 0px',
          threshold: [0.12, 0.25, 0.5, 0.75]
        }
      );

      sections.forEach((item) => observer.observe(item.section));

      nav.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) {
          return;
        }

        const topButton = target.closest('[data-detail-top]');
        if (topButton instanceof HTMLButtonElement) {
          event.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
          if (sections[0]) {
            setActive(sections[0].id);
            window.history.replaceState({}, '', '#top');
          }
          return;
        }

        const link = target.closest('[data-detail-tab]');
        if (!(link instanceof HTMLAnchorElement)) {
          return;
        }

        const id = link.getAttribute('data-detail-tab');
        const section = id ? document.getElementById(id) : null;
        if (!(section instanceof HTMLElement)) {
          return;
        }

        event.preventDefault();
        setActive(id);
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        window.history.replaceState({}, '', `#${id}`);
      });

      document.querySelectorAll('[data-rail-shell]').forEach((shell) => {
        if (!(shell instanceof HTMLElement)) {
          return;
        }

        const rails = [...shell.querySelectorAll('[data-rail-track]')].filter((rail) => rail instanceof HTMLElement);
        const prevButton = shell.querySelector('[data-rail-prev]');
        const nextButton = shell.querySelector('[data-rail-next]');

        if (!rails.length || !(prevButton instanceof HTMLButtonElement) || !(nextButton instanceof HTMLButtonElement)) {
          return;
        }

        let syncing = false;

        const syncButtons = () => {
          const currentScroll = Math.max(...rails.map((rail) => rail.scrollLeft));
          const maxScroll = Math.max(...rails.map((rail) => Math.max(0, rail.scrollWidth - rail.clientWidth)));
          const isAtStart = currentScroll <= 4;
          const isAtEnd = currentScroll >= maxScroll - 4;

          prevButton.hidden = isAtStart;
          nextButton.hidden = maxScroll <= 8 || isAtEnd;
          shell.toggleAttribute('data-can-scroll-left', !isAtStart);
          shell.toggleAttribute('data-can-scroll-right', !(maxScroll <= 8 || isAtEnd));
        };

        const queueSync = () => window.requestAnimationFrame(syncButtons);

        prevButton.addEventListener('click', () => {
          const step = Math.max(Math.max(...rails.map((rail) => rail.clientWidth)) * 0.72, 220);
          rails.forEach((rail) => {
            rail.scrollBy({ left: -step, behavior: 'smooth' });
          });
        });

        nextButton.addEventListener('click', () => {
          const step = Math.max(Math.max(...rails.map((rail) => rail.clientWidth)) * 0.72, 220);
          rails.forEach((rail) => {
            rail.scrollBy({ left: step, behavior: 'smooth' });
          });
        });

        rails.forEach((rail) => {
          rail.addEventListener('scroll', () => {
            if (syncing || !shell.hasAttribute('data-rail-sync')) {
              queueSync();
              return;
            }

            syncing = true;
            rails.forEach((peer) => {
              if (peer !== rail) {
                peer.scrollLeft = rail.scrollLeft;
              }
            });
            syncing = false;
            queueSync();
          }, { passive: true });
        });

        window.addEventListener('resize', queueSync);

        rails.forEach((rail) => {
          rail.querySelectorAll('img').forEach((image) => {
            if (!(image instanceof HTMLImageElement)) {
              return;
            }

            if (image.complete) {
              return;
            }

            image.addEventListener('load', queueSync, { once: true });
            image.addEventListener('error', queueSync, { once: true });
          });
        });

        if ('ResizeObserver' in window) {
          const resizeObserver = new ResizeObserver(queueSync);
          rails.forEach((rail) => resizeObserver.observe(rail));
        }

        queueSync();
        window.setTimeout(queueSync, 120);
      });

      document.querySelectorAll('[data-review-card]').forEach((card) => {
        if (!(card instanceof HTMLElement)) {
          return;
        }

        const content = card.querySelector('[data-review-content]');
        const expandButton = card.querySelector('[data-review-expand]');
        const expandText = card.querySelector('[data-expand-text]');
        const expandIcon = card.querySelector('.review-card__expand-icon');

        if (!(content instanceof HTMLElement) || !(expandButton instanceof HTMLButtonElement)) {
          return;
        }

        const checkTruncation = () => {
          const isTruncated = content.scrollHeight > content.clientHeight + 10;
          expandButton.style.display = isTruncated ? '' : 'none';
          
          if (isTruncated) {
            content.setAttribute('data-truncated', '');
          } else {
            content.removeAttribute('data-truncated');
          }
        };

        let isExpanded = false;

        expandButton.addEventListener('click', () => {
          isExpanded = !isExpanded;
          content.classList.toggle('is-expanded', isExpanded);
          card.classList.toggle('is-expanded', isExpanded);
          
          if (expandText) {
            expandText.textContent = isExpanded ? '收起评论' : '展开全文';
          }
          
          if (expandIcon) {
            expandIcon.textContent = isExpanded ? '▲' : '▼';
          }
        });

        checkTruncation();
        window.addEventListener('resize', checkTruncation);
      });
    })();
  </script>
</div>
