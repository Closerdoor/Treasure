---
import type { ArchiveMovie } from '../lib/archive';
import { formatArchiveListFacts, formatArchiveListPlatformRatings } from '../lib/site';

const { movie } = Astro.props as { movie: ArchiveMovie };
const facts = formatArchiveListFacts(movie);
const platformRatings = formatArchiveListPlatformRatings(movie);

const factIcons = [
  'M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11zM9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm-8 4H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z',
  'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z',
  'M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z'
] as const;

const directorIcon = 'M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z';
const castIcon = 'M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z';
const summaryIcon = 'M14 17H4v2h10v-2zm6-8H4v2h16V9zM4 15h16v-2H4v2zM4 5v2h16V5H4z';

---

<article class="movie-list-card">
  <a class="movie-list-card__poster" href={movie.path}>
    <img src={movie.posterUrl} alt={`${movie.title} 海报`} loading="lazy" />
  </a>

  <div class="movie-list-card__body">
    <a class="movie-list-card__detail-link" href={movie.path}>查看详情</a>

    <div class="movie-list-card__title-row">
      <a class="movie-list-card__title" href={movie.path}>{movie.title}</a>
      <p class="movie-list-card__subtitle">{movie.originalTitle}</p>
    </div>

    <div class="movie-list-card__facts">
      {facts.map((fact, index) => (
        <span class="movie-list-card__fact-chip">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={factIcons[index] ?? factIcons[0]}></path></svg>
          {fact}
        </span>
      ))}
    </div>

    <div class="movie-list-card__director-row">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={directorIcon}></path></svg>
      <span>导演：{movie.directorNames}</span>
    </div>

    <div class="movie-list-card__cast-row">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={castIcon}></path></svg>
      <span>主演：{movie.castPreview.join(' / ')}</span>
    </div>

    <div class="movie-list-card__summary-row">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d={summaryIcon}></path></svg>
      <span>简介：{movie.synopsis?.text}</span>
    </div>
  </div>

  <div class="movie-list-card__ratings">
    <div class="movie-list-card__score">
      <span>综合评分</span>
      <strong>{movie.aggregateRating ? movie.aggregateRating.toFixed(1) : '--'}</strong>
    </div>

    <div class="movie-list-card__platforms">
      {platformRatings.map((item) => (
        <span class="movie-list-card__rating-item">
          <span class="movie-list-card__rating-source">{item.label}</span>
          <strong class="movie-list-card__rating-value">{item.value}</strong>
        </span>
      ))}
    </div>
  </div>
</article>
