---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MovieGridCard from '../../components/MovieGridCard.astro';
import MovieListCard from '../../components/MovieListCard.astro';
import { loadArchiveMovies } from '../../lib/archive';
import { buildVideoViewModel, collectCountries, collectYears, filterMovies } from '../../lib/site';

const allMovies = await loadArchiveMovies();

const query = Astro.url.searchParams.get('q') ?? '';
const submodule = Astro.url.searchParams.get('submodule') ?? '';
const genre = Astro.url.searchParams.get('genre') ?? '';
const country = Astro.url.searchParams.get('country') ?? '';
const year = Astro.url.searchParams.get('year') ?? '';
const viewModel = buildVideoViewModel({
  query,
  submodule,
  genre,
  country,
  year,
  view: Astro.url.searchParams.get('view') ?? ''
});
const view = viewModel.view;

const movies = filterMovies(allMovies, { query, submodule, genre, country, year });
const years = collectYears(allMovies);
const countries = collectCountries(allMovies);
const genres = [...new Set(allMovies.flatMap((movie) => movie.genre ?? []))].sort();
const submodules = [
  { value: 'movie', label: '电影', enabled: true },
  { value: 'series', label: '电视剧', enabled: false },
  { value: 'documentary', label: '纪录片', enabled: false },
  { value: 'animation', label: '动漫', enabled: false },
  { value: 'short', label: '短片', enabled: false }
];
const page = Math.max(1, Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);
const pageSize = 12;
const totalPages = Math.max(1, Math.ceil(movies.length / pageSize));
const currentPage = Math.min(page, totalPages);
const pagedMovies = movies.slice((currentPage - 1) * pageSize, currentPage * pageSize);
const activeFilters = [
  query ? `搜索: ${query}` : '',
  submodule ? `子模块: ${submodule}` : '',
  genre ? `类型: ${genre}` : '',
  country ? `地区: ${country}` : '',
  year ? `年份: ${year}` : ''
].filter(Boolean);

const filterRows = [
  { label: '类型', key: 'genre', options: genres.slice(0, 12) },
  { label: '地区', key: 'country', options: countries.slice(0, 14) },
  { label: '年份', key: 'year', options: years.slice(0, 16).map(String) }
] as const;

function buildVideoPageHref(overrides: Record<string, string>) {
  const params = new URLSearchParams({
    q: query,
    submodule,
    genre,
    country,
    year,
    view,
    page: String(currentPage)
  });

  Object.entries(overrides).forEach(([key, value]) => {
    if (!value) {
      params.delete(key);
      return;
    }

    params.set(key, value);
  });

  if (params.get('page') === '1') {
    params.delete('page');
  }

  return `/video?${params.toString()}`;
}
---

<BaseLayout title="影视分馆 | Treasure 资料馆">
  <section class="shell filters-panel filters-panel--compact">
    <form class="archive-search-bar" method="get">
      <input name="q" type="search" value={query} placeholder="搜索标题、原名、演员" />
      <input type="hidden" name="submodule" value={submodule} />
      <input type="hidden" name="genre" value={genre} />
      <input type="hidden" name="country" value={country} />
      <input type="hidden" name="year" value={year} />
      <input type="hidden" name="view" value={view} />
      <button class="button button--primary" type="submit">搜索</button>
      <a class="button button--ghost" href="/video">清空</a>
    </form>

    <div class="submodule-filter-panel">
      <span class="submodule-filter-panel__label">子模块</span>
      <div class="submodule-filter-panel__options">
        {submodules.map((item) => {
          const isActive = submodule === item.value || (!submodule && item.value === 'movie');

          return item.enabled ? (
            <a class:list={["submodule-filter-panel__option", isActive && 'is-active']} href={buildVideoPageHref({ submodule: item.value, page: '1' })}>{item.label}</a>
          ) : (
            <span class="submodule-filter-panel__option is-disabled">{item.label}</span>
          );
        })}
      </div>
    </div>

    <div class="filter-link-rows">
      {filterRows.map((row) => (
        <div class="filter-link-row">
          <span class="filter-link-row__label">{row.label}</span>
          <div class="filter-link-row__options">
            {row.options.map((item) => {
              const isActive =
                (row.key === 'genre' && genre === item) ||
                (row.key === 'country' && country === item) ||
                (row.key === 'year' && year === item);

              return (
                <a class:list={["filter-link-row__option", isActive && 'is-active']} href={buildVideoPageHref({ [row.key]: isActive ? '' : item, page: '1' })}>
                  {item}
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="shell listing-toolbar">
    <p>共 {movies.length} 条内容，当前第 {currentPage} / {totalPages} 页。</p>
    <div class="listing-toolbar__views" data-view-switcher>
      <a class:list={[view === 'grid' && 'is-active']} href={viewModel.viewLinks.card} data-view-option="grid">卡片</a>
      <a class:list={[view === 'list' && 'is-active']} href={viewModel.viewLinks.list} data-view-option="list">列表</a>
    </div>
  </section>

  {activeFilters.length ? (
    <section class="shell active-filter-bar">
      {activeFilters.map((item) => (
        <span>{item}</span>
      ))}
    </section>
  ) : null}

  {movies.length ? (
    <>
      <section class:list={["shell", "grid-cards", view !== 'grid' && 'is-hidden']} data-view-panel="grid">
        {pagedMovies.map((movie) => (
          <MovieGridCard movie={movie} />
        ))}
      </section>

      <section class:list={["shell", "list-cards", view !== 'list' && 'is-hidden']} data-view-panel="list">
        {pagedMovies.map((movie) => (
          <MovieListCard movie={movie} />
        ))}
      </section>

      <nav class="shell pagination-bar" aria-label="列表分页">
        <a class:list={["pagination-bar__button", currentPage === 1 && 'is-disabled']} href={currentPage === 1 ? buildVideoPageHref({ page: '1' }) : buildVideoPageHref({ page: String(currentPage - 1) })}>上一页</a>
        <div class="pagination-bar__pages">
          {Array.from({ length: totalPages }, (_, index) => index + 1).map((item) => (
            <a class:list={["pagination-bar__page", item === currentPage && 'is-active']} href={buildVideoPageHref({ page: String(item) })}>{item}</a>
          ))}
        </div>
        <a class:list={["pagination-bar__button", currentPage === totalPages && 'is-disabled']} href={currentPage === totalPages ? buildVideoPageHref({ page: String(totalPages) }) : buildVideoPageHref({ page: String(currentPage + 1) })}>下一页</a>
      </nav>
    </>
  ) : (
    <section class="shell">
      <article class="empty-state">
        <p class="eyebrow">Archive Empty</p>
        <h2>当前筛选下没有匹配条目。</h2>
        <p>可以先清空筛选，回到默认馆藏继续浏览。</p>
        <a class="button button--primary" href="/video">返回默认列表</a>
      </article>
    </section>
  )}

  <script is:inline>
    (() => {
      const switcher = document.querySelector('[data-view-switcher]');
      const panels = [...document.querySelectorAll('[data-view-panel]')];
      if (!(switcher instanceof HTMLElement) || panels.length === 0) {
        return;
      }

      const options = [...switcher.querySelectorAll('[data-view-option]')];
      const applyView = (nextView) => {
        const isCard = nextView !== 'list';

        panels.forEach((panel) => {
          if (!(panel instanceof HTMLElement)) {
            return;
          }

          const isMatch = panel.dataset.viewPanel === (isCard ? 'grid' : 'list');
          panel.classList.toggle('is-hidden', !isMatch);
        });

        options.forEach((link) => {
          if (!(link instanceof HTMLElement)) {
            return;
          }

          link.classList.toggle('is-active', link.dataset.viewOption === (isCard ? 'grid' : 'list'));
        });
      };

      const current = new URL(window.location.href).searchParams.get('view');
      applyView(current === 'list' ? 'list' : 'grid');

      switcher.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) {
          return;
        }

        const link = target.closest('[data-view-option]');
        if (!(link instanceof HTMLAnchorElement)) {
          return;
        }

        event.preventDefault();
        const nextView = link.dataset.viewOption === 'list' ? 'list' : 'grid';
        const url = new URL(link.href, window.location.origin);
        window.history.replaceState({}, '', url);
        applyView(nextView);
      });
    })();
  </script>
</BaseLayout>
