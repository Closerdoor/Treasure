  "reviews": [
    {
      "source": "豆瓣",
      "author": "飞风",
      "date": "2026-04-24",
      "rating": "力荐",
      "content": "我艹！看个屁！只拍到1988年的bad的全球巡演？？后面呢！！后面全没了！！我还没看够啊！赶紧拍续集！！！故事算个屁！能在电影院大荧幕上看到他的mv，演唱会，现场，就够了！就够了懂吗！赶紧拍续集！！"
    },
    {
      "source": "豆瓣",
      "author": "Mr. Infamous",
      "date": "2026-04-23",
      "rating": "推荐",
      "content": "相比金曲，对于MJ前半生平，恰好了解不足，而又意兴不减，毕竟一位黑人巨星在七八十年代的金身塑成，本就交杂家庭伦理、流行趋势、社会氛围等多重议题。电影触及很多未曾想过的地方，除却出道与登顶之年幼，便是他抗争行动的童稚与艰难。一个小孩如何突破控制，争夺自由，保持不同，堪称传奇，而又更显悲凉。"
    },
    {
      "source": "豆瓣",
      "author": "壹安²",
      "date": "2026-04-23",
      "rating": "力荐",
      "content": "永远且唯一的世界流行之王，视听层面的核爆享受。原来Michael Jackson也会宴请自己的童年。"
    },
    {
      "source": "豆瓣",
      "author": "Anakin",
      "date": "2026-04-23",
      "rating": "还行",
      "content": "作为这个星球上最大的腕儿，MJ确实值得一部更好的传记片。。"
    },
    {
      "source": "豆瓣",
      "author": "脑洞惊风雨",
      "date": "2026-04-23",
      "rating": "力荐",
      "content": "这辈子还有几次机会能在这么大的屏幕上看到（贾法尔cos的）MJ贴脸给你唱Billie Jean跳太空步？"
    }
  ],
